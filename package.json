{
  "name": "humpty-dumpty-admin-next",
  "version": "0.3.0",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm:start-client\" \"npm:start-electron\"",
    "start-client": "cd client && npm run dev",
    "start-electron": "wait-on http://localhost:5173 && electron .",
    "build:renderer": "cd client && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:win:nsis": "npm run build:renderer && electron-builder --win nsis",
    "dist:win:portable": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "concurrently": "^9.2.0",
    "sqlite3": "^5.1.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.humpty.school.admin.next",
    "productName": "Humpty Dumpty Admin Next",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "client/dist/**/*",
      "package.json",
      "!**/*.db"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
